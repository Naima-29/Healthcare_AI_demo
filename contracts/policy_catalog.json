{
  "version": "1.1.0",
  "surfaces": [
    "patient_channel",
    "clinical_board",
    "director_console"
  ],
  "gate_roles": [
    "clinician:nephrology",
    "clinician:radiology",
    "clinician:urology_oncology",
    "clinician:genetics",
    "director"
  ],
  "tools": {
    "channel.send_message": {
      "server": "channel",
      "surface": "patient_channel"
    },
    "fhir.read_patient": {
      "server": "fhir"
    },
    "fhir.read_observations": {
      "server": "fhir"
    },
    "fhir.read_medications": {
      "server": "fhir"
    },
    "fhir.write_medication_request": {
      "server": "fhir"
    },
    "pacs.fetch_study": {
      "server": "pacs"
    },
    "ct.classify": {
      "server": "ct"
    },
    "genomics.read_panel": {
      "server": "genomics"
    },
    "genomics.write_classification": {
      "server": "genomics"
    },
    "wearables.read_series": {
      "server": "wearables"
    },
    "lab.read_results": {
      "server": "lab"
    },
    "km.lookup": {
      "server": "km"
    },
    "oncall.who_is_on_call": {
      "server": "oncall"
    },
    "oncall.page": {
      "server": "oncall"
    },
    "deid.anonymise": {
      "server": "deid"
    },
    "cloud_llm.complete_deidentified": {
      "server": "cloud_gateway"
    },
    "cloud_llm.complete_raw": {
      "server": "cloud_gateway"
    },
    "board.publish_case_pack": {
      "server": "board",
      "surface": "clinical_board"
    },
    "control_plane.propose_manifest": {
      "server": "control_plane",
      "surface": "director_console"
    },
    "control_plane.activate_manifest": {
      "server": "control_plane"
    },
    "pacs.list_studies": {
      "server": "pacs"
    },
    "pacs.write_study": {
      "server": "pacs"
    },
    "board.read_artifact": {
      "server": "board"
    },
    "cortex.confirm_rule": {
      "server": "cortex"
    },
    "model.train_on_patient_data": {
      "server": "model_ops"
    }
  },
  "refusals": {
    "no_diagnosis": {
      "description": "Never state a diagnosis that a clinician has not released.",
      "release_gated_content": [
        "diagnosis"
      ]
    },
    "no_prescribing": {
      "description": "Never prescribe, start, stop or change a dose.",
      "blocked_tools": [
        "fhir.write_medication_request"
      ],
      "release_gated_content": [
        "dose"
      ]
    },
    "no_result_disclosure": {
      "description": "Never tell the patient a result before a clinician releases it.",
      "release_gated_content": [
        "imaging_result",
        "lab_interpretation",
        "genomic_result"
      ]
    },
    "no_variant_reclassification": {
      "description": "Report variant classes from the Knowledge Model only; never reclassify.",
      "blocked_tools": [
        "genomics.write_classification"
      ]
    },
    "no_identifiable_data_to_cloud": {
      "description": "Identifiable data never leaves the hospital edge.",
      "blocked_tools": [
        "cloud_llm.complete_raw"
      ]
    },
    "no_patient_contact": {
      "description": "Only the Companion talks to the patient.",
      "blocked_tools": [
        "channel.send_message"
      ]
    },
    "no_self_activation": {
      "description": "A manifest goes live only after the Director approves it.",
      "blocked_tools": [
        "control_plane.activate_manifest"
      ]
    },
    "no_image_alteration": {
      "description": "Never modify, overwrite or delete an image in PACS.",
      "blocked_tools": [
        "pacs.write_study"
      ]
    },
    "no_rule_self_confirmation": {
      "description": "A trial memory rule goes live only when a clinician confirms it.",
      "blocked_tools": [
        "cortex.confirm_rule"
      ]
    },
    "no_patient_data_in_weights": {
      "description": "Never write patient data into shared model weights; per-patient memory stays erasable.",
      "blocked_tools": [
        "model.train_on_patient_data"
      ]
    }
  }
}
