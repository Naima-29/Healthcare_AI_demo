{
  "version": "2.0.0",
  "source": "Vocabulary from demo/kidney-care-desk/contracts/catalog.mjs (v2 demo). Core additions: refusal activate_without_approval, gate director_approval, surface control_plane, and tool_actions.",
  "content_classes": [
    "diagnosis_claim",
    "imaging_result",
    "dose_instruction",
    "prescription",
    "genetic_result"
  ],
  "refusals": {
    "diagnose": {
      "label": "Never diagnose",
      "actions": [
        "patient.state_diagnosis"
      ],
      "content": [
        "diagnosis_claim"
      ]
    },
    "prescribe": {
      "label": "Never prescribe",
      "actions": [
        "medication.prescribe"
      ],
      "content": [
        "prescription"
      ]
    },
    "change_dose": {
      "label": "Never change or stop a dose",
      "actions": [
        "medication.change_dose"
      ],
      "content": [
        "dose_instruction"
      ]
    },
    "disclose_imaging_before_review": {
      "label": "Never disclose an imaging result before clinician review",
      "actions": [
        "patient.disclose_imaging"
      ],
      "content": [
        "imaging_result"
      ]
    },
    "disclose_genetics_to_patient": {
      "label": "Never disclose genetic findings to the patient",
      "actions": [
        "patient.disclose_genetics"
      ],
      "content": [
        "genetic_result"
      ]
    },
    "contact_clinician_directly": {
      "label": "Never contact a clinician directly (only via Dispatcher)",
      "actions": [
        "clinician.direct_message"
      ],
      "content": []
    },
    "answer_patient_directly": {
      "label": "Never answer the patient directly",
      "actions": [
        "patient.send"
      ],
      "content": []
    },
    "rank_clinicians": {
      "label": "Never rank clinicians by measured behaviour",
      "actions": [
        "routing.rank_people"
      ],
      "content": []
    },
    "label_as_diagnosis": {
      "label": "Never call a model output a diagnosis",
      "actions": [
        "imaging.label_diagnosis"
      ],
      "content": [
        "diagnosis_claim"
      ]
    },
    "report_to_patient": {
      "label": "Never report to the patient",
      "actions": [
        "patient.send",
        "patient.disclose_imaging"
      ],
      "content": []
    },
    "alter_image": {
      "label": "Never alter an image",
      "actions": [
        "pacs.write"
      ],
      "content": []
    },
    "reclassify_variants": {
      "label": "Never reclassify a variant",
      "actions": [
        "genomics.reclassify"
      ],
      "content": []
    },
    "pass_failed_check": {
      "label": "Never pass a failed check",
      "actions": [
        "verifier.override"
      ],
      "content": []
    },
    "alter_record": {
      "label": "Never alter a clinical record",
      "actions": [
        "fhir.write",
        "pacs.write"
      ],
      "content": []
    },
    "decide": {
      "label": "Never take the clinical decision",
      "actions": [
        "case.decide"
      ],
      "content": []
    },
    "send_to_patient": {
      "label": "Never send anything to the patient",
      "actions": [
        "patient.send"
      ],
      "content": []
    },
    "store_without_evidence": {
      "label": "Never store a rule without evidence",
      "actions": [
        "cortex.store_unevidenced"
      ],
      "content": []
    },
    "auto_confirm_rule": {
      "label": "Never auto-confirm a rule",
      "actions": [
        "cortex.confirm_rule"
      ],
      "content": []
    },
    "write_general_weights": {
      "label": "Never write patient data into general model weights",
      "actions": [
        "model.train_general"
      ],
      "content": []
    },
    "transmit_identifiable_external": {
      "label": "Never send identifiable data outside the perimeter",
      "actions": [
        "llm.external_identifiable"
      ],
      "content": []
    },
    "activate_without_approval": {
      "label": "Never put a manifest live without the Director's approval",
      "actions": [
        "manifest.activate"
      ],
      "content": []
    }
  },
  "gates": {
    "clinical_advice": {
      "label": "Any clinical advice to the patient",
      "signer": "treating_clinician"
    },
    "urgent_ack": {
      "label": "Urgent escalation acknowledged",
      "signer": "oncall_clinician"
    },
    "radiologist_review": {
      "label": "Imaging signal reviewed",
      "signer": "radiologist"
    },
    "genetic_disclosure": {
      "label": "Genetic findings disclosed",
      "signer": "geneticist"
    },
    "nephrologist_review": {
      "label": "Medication change reviewed",
      "signer": "nephrologist"
    },
    "clinician_signoff": {
      "label": "Case pack signed",
      "signer": "treating_clinician"
    },
    "rule_confirmation": {
      "label": "New rule confirmed",
      "signer": "clinician"
    },
    "none": {
      "label": "No human gate (automatic)",
      "signer": null
    },
    "director_approval": {
      "label": "Manifest change approved by the Director",
      "signer": "director"
    }
  },
  "surfaces": {
    "fhir": [
      "fhir.get_patient",
      "fhir.get_observations",
      "fhir.get_conditions",
      "fhir.get_medications"
    ],
    "pacs": [
      "pacs.list_studies",
      "pacs.fetch_study"
    ],
    "imaging": [
      "ct.classify",
      "ct.gradcam_heatmap",
      "ct.quality_ood_check"
    ],
    "lab": [
      "lab.parse_report",
      "lab.latest"
    ],
    "genomics": [
      "genomics.get_panel"
    ],
    "wearables": [
      "wearables.read"
    ],
    "oncall": [
      "oncall.who_is_on_call",
      "oncall.page"
    ],
    "channel": [
      "channel.send",
      "channel.receive"
    ],
    "km": [
      "km.query",
      "km.check_conflicts",
      "km.red_flags",
      "km.interpret_variant",
      "km.ckd_stage"
    ],
    "cortex": [
      "cortex.evidence_append",
      "cortex.knowledge_propose",
      "cortex.knowledge_read"
    ],
    "control_plane": [
      "control_plane.propose_manifest",
      "control_plane.activate_manifest"
    ]
  },
  "internal_tools": [
    "a2a.send",
    "a2a.endpoint",
    "board.create_item",
    "board.update_item"
  ],
  "tool_actions": {
    "channel.send": [
      "patient.send"
    ],
    "control_plane.activate_manifest": [
      "manifest.activate"
    ]
  }
}
