{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "message",
            "observation",
            "study",
            "document",
            "variant",
            "series"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Medication": {
      "additionalProperties": false,
      "properties": {
        "dose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose"
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rxnorm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rxnorm"
        },
        "source": {
          "enum": [
            "patient_reported",
            "fhir"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Medication",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "medications": {
      "items": {
        "$ref": "#/$defs/Medication"
      },
      "minItems": 1,
      "title": "Medications",
      "type": "array"
    }
  },
  "required": [
    "medications"
  ],
  "title": "MedicationReport",
  "type": "object"
}
