{
  "$defs": {
    "RedFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detected_by": {
          "enum": [
            "rules",
            "model",
            "both"
          ],
          "title": "Detected By",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        }
      },
      "required": [
        "code",
        "detected_by"
      ],
      "title": "RedFlag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "citations": {
      "items": {
        "description": "Knowledge Model citation, e.g. '[14] KDIGO 2024 ...'",
        "minLength": 3,
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "flags": {
      "description": "Which detector fired (rules, model or both)",
      "items": {
        "$ref": "#/$defs/RedFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "pattern": {
      "description": "Red-flag pattern from the Knowledge Model",
      "title": "Pattern",
      "type": "string"
    },
    "safety_script_sent": {
      "default": false,
      "title": "Safety Script Sent",
      "type": "boolean"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "On-call unit to page; the Dispatcher's default if absent",
      "title": "Unit"
    },
    "urgency": {
      "enum": [
        "high",
        "medium"
      ],
      "title": "Urgency",
      "type": "string"
    }
  },
  "required": [
    "urgency",
    "pattern",
    "evidence"
  ],
  "title": "RedFlagEscalation",
  "type": "object"
}
