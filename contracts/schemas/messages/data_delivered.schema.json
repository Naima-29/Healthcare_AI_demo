{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "message",
            "observation",
            "study",
            "document",
            "variant",
            "series",
            "evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "citations": {
      "items": {
        "description": "Knowledge Model citation, e.g. '[14] KDIGO 2024 ...'",
        "minLength": 3,
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Id"
    },
    "kind": {
      "description": "lab, genomic_context, wearable_series, ...",
      "pattern": "^[a-z][a-z_]{1,40}$",
      "title": "Kind",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "data"
  ],
  "title": "DataDelivered",
  "type": "object"
}
