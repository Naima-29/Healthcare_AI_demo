{
  "$defs": {
    "Humanized": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio"
        },
        "fuzzy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fuzzy"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video"
        }
      },
      "title": "Humanized",
      "type": "object"
    },
    "MemoryScopes": {
      "additionalProperties": false,
      "properties": {
        "partition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition"
        },
        "read": {
          "items": {
            "enum": [
              0,
              1,
              2,
              3
            ],
            "type": "integer"
          },
          "title": "Read",
          "type": "array"
        },
        "write": {
          "items": {
            "enum": [
              0,
              1,
              2,
              3
            ],
            "type": "integer"
          },
          "title": "Write",
          "type": "array"
        }
      },
      "title": "MemoryScopes",
      "type": "object"
    },
    "MessageType": {
      "enum": [
        "symptom_report",
        "red_flag_escalation",
        "medication_report",
        "data_request",
        "data_delivered",
        "imaging_signal",
        "therapy_conflict",
        "case_pack_ready",
        "clinician_decision",
        "acknowledgment"
      ],
      "title": "MessageType",
      "type": "string"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "description": "Edge model id, or 'none' for a deterministic seat",
          "title": "Edge",
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cloud fallback; only ever sees de-identified data",
          "title": "Fallback"
        }
      },
      "required": [
        "edge"
      ],
      "title": "ModelSpec",
      "type": "object"
    },
    "Unit": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Billing unit, e.g. 'per_check'",
          "title": "Kind",
          "type": "string"
        },
        "tc": {
          "description": "Token-credits per unit",
          "minimum": 0,
          "title": "Tc",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "tc"
      ],
      "title": "Unit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "a2a_peers": {
      "description": "Seats this seat may address (via the Dispatcher)",
      "items": {
        "type": "string"
      },
      "title": "A2A Peers",
      "type": "array"
    },
    "artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact"
    },
    "compiled_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compiled At"
    },
    "compiled_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compiled By"
    },
    "consumes": {
      "items": {
        "$ref": "#/$defs/MessageType"
      },
      "title": "Consumes",
      "type": "array"
    },
    "desk": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Desk"
    },
    "emits": {
      "items": {
        "$ref": "#/$defs/MessageType"
      },
      "title": "Emits",
      "type": "array"
    },
    "gates": {
      "description": "Gate ids from the catalogue; ['none'] if automatic",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "humanized": {
      "anyOf": [
        {
          "$ref": "#/$defs/Humanized"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_description": {
      "minLength": 20,
      "title": "Job Description",
      "type": "string"
    },
    "location": {
      "enum": [
        "patient_edge",
        "hospital_edge"
      ],
      "title": "Location",
      "type": "string"
    },
    "memory": {
      "$ref": "#/$defs/MemoryScopes"
    },
    "model": {
      "$ref": "#/$defs/ModelSpec"
    },
    "name": {
      "minLength": 2,
      "title": "Name",
      "type": "string"
    },
    "refuses": {
      "items": {
        "type": "string"
      },
      "title": "Refuses",
      "type": "array"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "safety_script": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Script"
    },
    "seat": {
      "pattern": "^[a-z][a-z0-9_]{1,40}$",
      "title": "Seat",
      "type": "string"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "surfaces": {
      "items": {
        "type": "string"
      },
      "title": "Surfaces",
      "type": "array"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "unit": {
      "$ref": "#/$defs/Unit"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "seat",
    "name",
    "version",
    "location",
    "model",
    "gates",
    "unit",
    "job_description"
  ],
  "title": "Manifest",
  "type": "object"
}
