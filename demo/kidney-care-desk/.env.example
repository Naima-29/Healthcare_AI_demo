# Kidney Care Desk v2 - configuration. Everything is optional:
# with nothing set, the demo runs fully offline on synthetic data.

PORT=5173
DEMO_LANG=en                  # en (default) or it - script, lab report, draft wording; agents reply in the user's language
DEMO_PACE=700                 # ms between agent hops (visual pacing on stage); 0 = instant
ESCALATION_SECONDS=90         # on-call acknowledgement timer (production: 600)
DEMO_NOW=2026-10-12T21:40:00+02:00   # demo clock, keeps data freshness stable
STALE_DAYS=90                 # kidney-function data older than this triggers a data_request
CALIBRATION_T=2.5             # temperature scaling for the CT classifier confidence

# --- Edge SLM (OpenAI-compatible: Ollama, vLLM, LM Studio...) - Loop Q on the hospital node
# EDGE_LLM_BASE_URL=http://localhost:11434/v1
# EDGE_LLM_MODEL=qwen3:4b
# EDGE_LLM_API_KEY=none

# --- Cloud teacher / fallback - only ever receives de-identified data
# CLOUD_LLM_BASE_URL=https://api.moonshot.ai/v1
# CLOUD_LLM_MODEL=kimi-k2
# CLOUD_LLM_API_KEY=...

# --- Hospital systems (MCP servers switch from synthetic to live)
# FHIR_BASE_URL=http://localhost:8080/fhir            # HAPI FHIR R4
# DICOMWEB_URL=http://localhost:8042/dicom-web        # Orthanc DICOMweb
# CT_MODEL_URL=http://localhost:9000/classify         # your v1 kidney CT classifier

# --- Patient channel: your v1 Telegram bot
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=                                   # optional; learned from the first message
