# Core service. Copy to .env for local runs (never commit .env).
KCD_ENV=dev
KCD_DATABASE_URL=postgresql://kcd:kcd_dev@localhost:5432/kcd
KCD_NATS_URL=nats://localhost:4222
KCD_KEYS_DIR=keys
KCD_PAGER=log
